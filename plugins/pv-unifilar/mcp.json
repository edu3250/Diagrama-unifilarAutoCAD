{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pvsld": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/edu3250/PvUnifilar@v0.5.0",
        "pvsld-mcp"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PVSLD_OUTPUT_DIR": "~/PvUnifilar",
        "PVSLD_MCP_PROMPTS": "off"
      }
    }
  }
}
